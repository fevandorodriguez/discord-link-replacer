DISCORD_TOKEN=
# Delivery mode: repost (delete and repost as the author) or suppress
# (leave the message, strip its embed, reply with the fixed link):
# LINKFIX_MODE=suppress
# Override a dead mirror without editing config.json:
# LINKFIX_INSTAGRAM_DOMAIN=toinstagram.com
# LINKFIX_TIKTOK_ENABLED=false

# Admin panel at discord.fev.space. Generate with:
#   npm run hash-password -- "your password"
# Unset means the panel does not start; the bot still runs.
ADMIN_PASSWORD_HASH=
# Optional: keeps sessions valid across restarts. Must be at least 32
# characters, or the panel refuses to start (see README). Left commented
# out here -- not set to an empty value -- on purpose: `SESSION_SECRET=`
# would be read back as the empty string, not "unset", and signing sessions
# with a known empty key is a full auth bypass. A random secret is
# generated at each boot when this stays unset.
# SESSION_SECRET=
# Optional: only needed if the default (3000) conflicts with something else
# on the host. If you set this, update the Caddyfile's reverse_proxy port
# to match -- see the Admin panel section in README.
# ADMIN_PORT=3000
